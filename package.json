{
  "name": "@joyfoxai/dsh-eco-router",
  "description": "Token-efficient model-routing flywheel for the DeepSeek Harness — observes (task → model → result), distills a routing table, and routes each task to the cheapest historically-successful model.",
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "model-routing",
    "token-efficiency",
    "llm",
    "ai-agent",
    "flywheel",
    "cordis"
  ],
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joyfoxai/dsh-eco-router.git"
  },
  "homepage": "https://github.com/joyfoxai/dsh-eco-router#readme",
  "bugs": {
    "url": "https://github.com/joyfoxai/dsh-eco-router/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./client": {
      "types": "./lib/client.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "src",
    "lib/client.js",
    "lib/client.d.ts"
  ],
  "scripts": {
    "build": "tsdown",
    "bundle": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-fs": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "^0.1.0-rc.5",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.5",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.0-rc.5"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsdown": "^0.2.0",
    "typescript": "^5.6.0",
    "@types/react": "^18.3.0"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  }
}
